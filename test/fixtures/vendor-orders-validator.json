{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "_id",
      "ts",
      "order_id",
      "vendor",
      "submitted_by",
      "status",
      "address"
    ],
    "additionalProperties": false,
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^EDI-[A-Za-z0-9-]+$",
        "description": "site EDI-<digits> or marketplace EDI-<SELLERCODE>-<rawOrderId>"
      },
      "ts": {
        "bsonType": "date"
      },
      "order_id": {
        "bsonType": "string",
        "pattern": "^[A-Za-z0-9-]+$",
        "description": "site numeric id or marketplace raw order id"
      },
      "vendor": {
        "bsonType": "string",
        "pattern": "^[a-z]+$"
      },
      "vendor_po_num": {
        "bsonType": "string",
        "pattern": "^EDI-[A-Za-z0-9-]+$"
      },
      "submitted_by": {
        "bsonType": "string"
      },
      "status": {
        "bsonType": "string",
        "pattern": "^(?:new|shipped|completed|send_error)$"
      },
      "items": {
        "bsonType": "array",
        "minimum": 1,
        "items": {
          "bsonType": "object",
          "required": [
            "sku",
            "vendor_sku",
            "unit_price",
            "qty"
          ],
          "additionalProperties": false,
          "properties": {
            "sku": {
              "bsonType": "string"
            },
            "vendor_sku": {
              "bsonType": "string"
            },
            "unit_price": {
              "bsonType": [
                "int",
                "double"
              ]
            },
            "qty": {
              "bsonType": "int"
            }
          }
        }
      },
      "total_before_shipping": {
        "bsonType": [
          "int",
          "double"
        ]
      },
      "address": {
        "bsonType": "object",
        "required": [
          "company_name",
          "name",
          "address_line1",
          "address_line2",
          "city",
          "state_province",
          "postal_code",
          "country_code"
        ],
        "additionalProperties": false,
        "properties": {
          "company_name": {
            "bsonType": "string"
          },
          "name": {
            "bsonType": "string"
          },
          "address_line1": {
            "bsonType": "string"
          },
          "address_line2": {
            "bsonType": "string"
          },
          "city": {
            "bsonType": "string"
          },
          "state_province": {
            "bsonType": "string"
          },
          "postal_code": {
            "bsonType": "string"
          },
          "country_code": {
            "bsonType": "string"
          }
        }
      },
      "invoice_date": {
        "bsonType": "string",
        "pattern": "^[\\d]{4}-[\\d]{2}-[\\d]{2}$"
      },
      "invoice_id": {
        "bsonType": "string"
      },
      "invoice_total": {
        "bsonType": [
          "int",
          "double"
        ]
      },
      "tracking_num": {
        "bsonType": "string"
      },
      "tracking_updated_at": {
        "bsonType": "date",
        "description": "when tracking was last populated on this PO"
      },
      "shipping_cost": {
        "bsonType": [
          "int",
          "double"
        ]
      },
      "carrier": {
        "bsonType": "string"
      },
      "signature_requested": {
        "bsonType": "bool"
      },
      "channel": {
        "bsonType": "string"
      },
      "seller_account": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "seller_code": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "marketplace_id": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "raw_order_id": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "source_order_id": {
        "bsonType": "string"
      },
      "send_error": {
        "bsonType": "string"
      },
      "marketplace_writeback_status": {
        "bsonType": "string"
      },
      "marketplace_writeback_attempt_at": {
        "bsonType": "date"
      },
      "marketplace_writeback_channel": {
        "bsonType": "string"
      },
      "marketplace_writeback_error": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "marketplace_writeback_confirmed_at": {
        "bsonType": "date"
      },
      "marketplace_writeback_carrier": {
        "bsonType": "string"
      },
      "marketplace_writeback_tracking_number": {
        "bsonType": "string"
      },
      "marketplace_writeback_failed_at": {
        "bsonType": "date"
      },
      "marketplace_writeback_http_status": {
        "bsonType": [
          "int",
          "double",
          "null"
        ]
      },
      "marketplace_writeback_last_error_at": {
        "bsonType": "date"
      }
    }
  }
}
